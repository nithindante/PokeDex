<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Pokemon Details</title>
	<link rel="stylesheet" type="text/css" href="/css/pokemon.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
		integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
	<header>
		<div class="header-div">
			<div class="header-left-div">
				<a href="/">HOME</a>
			</div>
			<div class="header-right-div">
				<a href="/pokemon">POKEMON</a>
				<a href="/trainer">TRAINER</a>
				<a href="/type">TYPES</a>
			</div>
		</div>
	</header>

	<div class="content-div">
		<div class="heading-div">
			<h1><%= obj ? obj.name : 'Pokemon Not Found' %></h1>
		</div>

		<% if (obj) { %>
		<div class="pokemon-detail">
			<div class="pokemon-card single">
				<div class="pokemon-image">
					<img src="<%= obj.imageurl || '/images/pokemon-placeholder.svg' %>" onerror="this.onerror=null;this.src='/images/pokemon-placeholder.svg'" alt="<%= obj.name %>">
				</div>
				<div class="pokemon-info">
					<h3><%= obj.name %></h3>
					<h4>#<%= obj.id %></h4>
					<p>Type: <% obj.type.forEach((t, i) => { %><%= i > 0 ? ' / ' : '' %><img src="<%= t.imageurl %>" alt="<%= t %>" style="height:1em; vertical-align:middle;"> <%= t.name %><% }); %></p>

					<div>
						<a href="/pokemon" class="btn btn-secondary">Back to list</a>

						<form method="post" action="/pokemon/<%= obj.id %>/delete" style="display:inline-block; margin-left:8px;"
							onsubmit="return confirm('Delete this Pokemon?');">
							<button type="submit" class="btn btn-danger">Delete Pokemon</button>
						</form>
					</div>
				</div>
			</div>
		</div>
		<% } else { %>
		<div class="heading-div"><h2>Sorry, that Pokemon could not be found.</h2></div>
		<% } %>
	</div>
</body>

</html>
