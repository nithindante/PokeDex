<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokemon</title>
    <link rel="stylesheet" type="text/css" href="css/pokemon.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <header>
        <div class="header-div">
            <div class="header-left-div">
                <a href="/">HOME</a>
            </div>
            <div class="header-right-div">
                <a href="/pokemon">POKEMON</a>
                <a href="/trainer">TRAINER</a>
                <a href="/type">TYPES</a>
            </div>
        </div>
    </header>
    <div class="content-div">
        <div class="heading-div">
            <h1>Pokemon</h1>
        </div>
        <div class="createButton"><a href="/pokemon/new" class="btn btn-primary">Add new Pokemon</a></div>
        <div class="pokemon-grids">
            <div class="pokemon-grid">
                <% pokemon.forEach((poke)=> { %>
                <a href="/pokemon/<%=poke.id%>" class="div-grids">
                    <div class="pokemon-card">
                        <div class="pokemon-image">
                            <img src="<%= poke.imageurl || '/images/pokemon-placeholder.svg' %>" onerror="this.onerror=null;this.src='/images/pokemon-placeholder.svg'" alt="<%= poke.name %>">
                        </div>
                        <div class="pokemon-info">
                            <h3><%= poke.name %></h3>
                            <h4>#<%= poke.id %></h4>
                            <p>Type: <% poke.type.forEach((t, i) => { %><%= i > 0 ? ' / ' : '' %><%= t %><% }); %></p>
                        </div>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
    </div>
</body>
</html>