<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trainer</title>
    <link rel="stylesheet" type="text/css" href="css/trainer.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <header>
        <div class="header-div">
            <div class="header-left-div">
                <a href="/">HOME</a>
            </div>
            <div class="header-right-div">
                <a href="/pokemon">POKEMON</a>
                <a href="/trainer">TRAINER</a>
                <a href="/type">TYPES</a>
            </div>
        </div>
    </header>
    <div class="content-div">
        <div class="heading-div">
           <h1>Trainer</h1>
        </div>
        <div class="createButton"><a href="/trainer/new" class="btn btn-primary">Add new Trainer</a></div>
        <div class="trainer-grids">
            <div class="trainer-grid">
                <% setTrainers.forEach((trainer) => { %>
                <a href="/trainer/<%= trainer.id %>" class="div-grids">
                    <div class="trainer-card">
                        <div class="trainer-image">
                            <img src="<%= trainer.imageurl || '/images/trainer-placeholder.svg' %>" onerror="this.onerror=null;this.src='/images/trainer-placeholder.svg'" alt="<%= trainer.name %>">
                        </div>
                        <div class="trainer-info">
                            <h3><%= trainer.trainer_name %></h3>
                            <p>ID: <%= trainer.id %></p>
                        </div>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
    </div>
</body>

</html>