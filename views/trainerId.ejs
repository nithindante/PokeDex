<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trainer Details</title>
    <link rel="stylesheet" type="text/css" href="/css/trainer.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <header>
        <div class="header-div">
            <div class="header-left-div">
                <a href="/">HOME</a>
            </div>
            <div class="header-right-div">
                <a href="/pokemon">POKEMON</a>
                <a href="/trainer">TRAINER</a>
                <a href="/type">TYPES</a>
            </div>
        </div>
    </header>

    <div class="content-div">
        <% if (trainer) { %>
        <div class="heading-div">
            <a href="/trainer" class="back-link">&larr; Back to Trainers</a>
            <h1><%= trainer.name %></h1>
            <h2>#
                <%= trainer.id %></h2>
        </div>

        <div class="trainer-detail">
            <div class="trainer-card single">
                <div class="trainer-image">
                    <img src="<%= trainer.imageUrl || '/images/trainer-placeholder.svg' %>" onerror="this.onerror=null;this.src='/images/trainer-placeholder.svg'" alt="<%= trainer.name %>" />
                </div>
                <div class="trainer-info">
                    <div class="trainer-header">
                        <h3><%= trainer.name %></h3>
                        <p class="trainer-meta">Trainer ID <%= trainer.id %> &middot; <%= (trainer.pokemon || []).length %> Pokémon</p>
                    </div>
                    <%- include('partials/pokemonRoster', { trainer }) %>

                    <form method="post" action="/trainer/<%= trainer.id %>/delete" data-confirm="Delete <%= trainer.name %>? This can't be undone.">
                        <a href="/trainer" class="btn btn-secondary">Back to list</a>
                        <button type="submit" id="deleteTrainerBtn" class="btn btn-danger">Delete Trainer</button>
                    </form>

                    <div id="addPokemonPanel" hidden>
                        <hr />
                        <h5>Add Pokémon</h5>
                        <form method="post" action="/trainer/<%= trainer.id %>/add">
                            <div class="pokemon-picker mb-2">
                                <% pokemon.forEach((p) => { %>
                                    <label class="pick-tile">
                                        <input type="checkbox" name="pokemon[]" value="<%= p.id %>">
                                        <img src="<%= p.imageurl || '/images/pokemon-placeholder.svg' %>" onerror="this.onerror=null;this.src='/images/pokemon-placeholder.svg'" alt="<%= p.name %>">
                                        <span><%= p.name %></span>
                                    </label>
                                <% }) %>
                            </div>
                            <button type="submit" class="btn btn-primary">Add Pokémon</button>
                        </form>
                    </div>
                </div>
                <script src="/js/roster.js"></script>
            </div>
        </div>
        <% } else { %>
        <div class="heading-div"><h2>Trainer not found</h2></div>
        <% } %>
    </div>
</body>

</html>
